{
  "$schema": "https://cyclonedx.org/schema/2.0/cyclonedx-2.0.schema.json",
  "specFormat": "CycloneDX",
  "specVersion": "2.0",
  "definitions": {
    "components": [
      {
        "type": "cryptographic-asset",
        "name": "TLS 1.3 handshake and certificate signature inventories",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "version": "1.3",
            "cipherSuites": [
              {
                "name": "TLS_AES_128_GCM_SHA256"
              }
            ],
            "tlsSignatureSchemes": [
              "rsa_pss_rsae_sha256",
              "rsa_pkcs1_sha256"
            ],
            "tlsSignatureSchemesHandshake": [
              "rsa_pss_rsae_sha256"
            ],
            "tlsSignatureSchemesCert": [
              "rsa_pkcs1_sha256"
            ]
          }
        }
      },
      {
        "type": "cryptographic-asset",
        "name": "TLS 1.2 handshake and certificate signature inventories",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "version": "1.2",
            "cipherSuites": [
              {
                "name": "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
                "tlsGroups": [
                  "x25519"
                ],
                "tlsSignatureSchemes": [
                  "rsa_pkcs1_sha256"
                ]
              }
            ],
            "tlsGroups": [
              "x25519"
            ],
            "tlsSignatureSchemesHandshake": [
              "rsa_pkcs1_sha256"
            ],
            "tlsSignatureSchemesCert": [
              "rsa_pkcs1_sha256"
            ]
          }
        }
      },
      {
        "type": "cryptographic-asset",
        "name": "Certificate-signature inventory without handshake-signature information",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "version": "1.3",
            "tlsSignatureSchemesCert": [
              "rsa_pkcs1_sha256"
            ]
          }
        }
      },
      {
        "type": "cryptographic-asset",
        "name": "Handshake-signature inventory without certificate-signature information",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "version": "1.3",
            "tlsSignatureSchemesHandshake": [
              "ed25519"
            ]
          }
        }
      },
      {
        "type": "cryptographic-asset",
        "name": "Empty purpose-specific signature inventories",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "version": "1.3",
            "tlsSignatureSchemesHandshake": [],
            "tlsSignatureSchemesCert": []
          }
        }
      }
    ]
  }
}
